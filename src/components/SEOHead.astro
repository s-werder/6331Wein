---
import { site } from "../data/site";
import { withBase } from "../lib/paths";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const title = Astro.props.title ? `${Astro.props.title} · ${site.name}` : site.seo.title;
const description = Astro.props.description ?? site.seo.description;
const image = new URL(withBase(Astro.props.image ?? site.seo.image), Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={Astro.props.noindex ? "noindex, nofollow" : "index, follow"} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="de_CH" />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
