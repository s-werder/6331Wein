---
import { withBase } from "../lib/paths";
---

<section class="land section">
  <div class="shell land-grid">
    <div class="land-copy reveal">
      <p class="eyebrow">Mehr als Reben</p>
      <h2>Ein Rebberg als Lebensraum.</h2>
      <p>
        Asthaufen, offene Bodenstellen, Blühstreifen und einheimische
        Wildsträucher schaffen Nahrung und Rückzugsorte für Igel,
        Wildbienen und Vögel. Zusammen mit dem benachbarten
        Umweltlehrgarten wird so die Biodiversität in Hünenberg gestärkt.
      </p>
    </div>
    <figure class="land-image reveal">
      <img src={withBase("images/biodiversity.jpg")} alt="Rebberg, Kapelle und blühende Wiesen in Hünenberg" width="1318" height="987" loading="lazy" />
    </figure>
  </div>
</section>
