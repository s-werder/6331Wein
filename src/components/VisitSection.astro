---
import { withBase } from "../lib/paths";
---

<section class="visit section" id="besuch">
  <img
    class="visit-image"
    src={withBase("images/team-work.jpg")}
    alt="Gäste bei einer Degustation zwischen den Reben"
    width="2048"
    height="1536"
    loading="lazy"
  />
  <div class="visit-card reveal">
    <p class="eyebrow">Rebberg erleben</p>
    <h2>Führung, Apéro<br />& Degustation.</h2>
    <p>
      Rund 30 Minuten durch den Rebberg, danach unsere Weine und ein Apéro:
      für Vereine, Firmen, Familien und Freundeskreise gestalten wir den
      Anlass persönlich und unkompliziert.
    </p>
    <button class="button button-dark" type="button" data-interest-value="Rebbergführung mit Degustation">
      Besuch anfragen
    </button>
  </div>
</section>
